    reverse_proxy bazarr:6767
}
requests.{$MEDIA_DOMAIN} {
    import private_tls
    import protected
    reverse_proxy jellyseerr:5055
}
downloads.{$MEDIA_DOMAIN} {
    import private_tls
    import protected
    reverse_proxy gluetun:8080
}

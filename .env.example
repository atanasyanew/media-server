# Copy to .env. Never commit .env or credentials.
# Resolve this name AND auth/sonarr/radarr/prowlarr/bazarr/requests/downloads subdomains
# to your server's LAN IP. Caddy uses a private CA; trust its root on your devices.
MEDIA_DOMAIN=media.home.arpa
TZ=Europe/Luxembourg
PUID=1000
PGID=1000
# Plex stays on the LAN, outside Surfshark. Change to the server's LAN IP for TV apps.
PLEX_BIND_IP=127.0.0.1
PLEX_TOKEN=
PLEX_CLAIM=
# Gluetun requires Surfshark Manual Setup > WireGuard credentials.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_COUNTRIES=Netherlands
# Optional webhook for health alerts; leave empty to log alerts locally.
ALERT_WEBHOOK=
